# KryptoBot - copie para .env e ajuste com cuidado.
# NUNCA faça commit do .env. Use uma API key de subconta, apenas Spot,
# com SAQUES DESABILITADOS e IP whitelist quando possível.

# --- Modo de execução ---
BOT_NAME=KryptoBot
EXCHANGE_ID=binance
QUOTE_CURRENCY=USDT
DRY_RUN=true
SANDBOX=false
CONFIRM_LIVE_TRADING=NO

# --- Credenciais (obrigatórias apenas quando DRY_RUN=false) ---
# Alternativa mais segura: EXCHANGE_API_KEY_FILE=/caminho/arquivo
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# TELEGRAM_BOT_TOKEN_FILE=/caminho/arquivo também é aceito.
# TELEGRAM_CHAT_ID não tem variante _FILE.

# --- Mercado e ciclo ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=15m
OHLCV_LIMIT=300
SCAN_INTERVAL_SECONDS=300

# --- Risco (limites duros validados no código) ---
PAPER_EQUITY=1000
MAX_POSITION_PCT=5
RISK_PER_TRADE_PCT=1
MAX_TOTAL_EXPOSURE_PCT=15
MAX_DAILY_DRAWDOWN_PCT=3
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=6
MIN_QUOTE_RESERVE_PCT=20
MIN_ORDER_QUOTE=10
FEE_RATE=0.001
COOLDOWN_AFTER_LOSS_MINUTES=60
CIRCUIT_BREAKER_FLATTEN=true

# --- Estratégia ---
EMA_FAST=21
EMA_SLOW=55
RSI_PERIOD=14
RSI_MIN=50
RSI_MAX=68
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2
ATR_PERIOD=14
VOLUME_MA_PERIOD=20
BREAKOUT_LOOKBACK=20
ENTRY_MIN_SCORE=4
MIN_VOLUME_RATIO=1.1
MIN_24H_QUOTE_VOLUME=10000000
MIN_ATR_PCT=0.5
MAX_ATR_PCT=6
STOP_ATR_MULT=2
MIN_STOP_PCT=1.5
MAX_STOP_PCT=4
TP_RR=2
MAX_LAST_CANDLE_GAIN_PCT=6

# --- Proteção e trailing ---
STOP_ORDER_TYPE=stop_loss
STOP_LIMIT_OFFSET_PCT=2
ENABLE_TRAILING_STOP=true
TRAILING_ATR_MULT=2.5
BREAKEVEN_AFTER_R=1
MIN_STOP_MOVE_PCT=0.3

# --- Permissões e API ---
ENFORCE_API_PERMISSIONS=true
API_PERMISSION_CHECK_STRICT=true
API_TIMEOUT_MS=30000
MAX_RETRIES=4
RETRY_BASE_DELAY=1

# --- Arquivos e logs ---
DATA_DIR=data
LOG_DIR=logs
STATE_FILE=state.json
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Telegram (opcional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
